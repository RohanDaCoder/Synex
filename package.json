{
	"name": "synex",
	"module": "index.ts",
	"private": true,
	"scripts": {
		"start": "bun dist/index.js",
		"dev": "bun --watch run src/",
		"build": "bun run lint && bun check && bun build src/index.ts --sourcemap --outdir=dist/ --production --target=bun",
		"build:node": "bun run build --target=node",
		"deploy": "bun run build && bun run start",
		"lint": "bun lint --config .oxlintrc.json",
		"format": "bun fmt --config .prettierrc"
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.20.0",
		"discord.js": "^14.27.0",
		"dotenv": "^18.0.8",
		"parse-duration": "^2.1.9",
		"yoctocolors": "^2.2.0"
	}
}